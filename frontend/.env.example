# Frontend development URL: http://localhost:5173
FRONTEND_PORT=5173

# Backend URL used by Vite's development proxy (not exposed to browsers).
BACKEND_URL=http://localhost:5000

# Shared API prefix. Production defaults to the same-origin Nginx proxy.
# For a separate API domain, use https://api.example.com/api and configure
# backend CLIENT_URL and production cookie settings for that frontend origin.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
